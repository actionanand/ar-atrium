{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "checkedOn": {
      "type": "string",
      "minLength": 1
    },
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "access": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "homepage": {
            "type": [
              "string",
              "null"
            ]
          },
          "defaultBranch": {
            "type": [
              "string",
              "null"
            ]
          },
          "checkedOn": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "readmeUrl": {
            "type": "string",
            "minLength": 1
          },
          "readmeHeading": {
            "type": "string",
            "minLength": 1
          },
          "npmLinks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "expectedProjectType": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "url",
          "access"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "repositories"
  ]
}
