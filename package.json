{
  "name": "ar-atrium",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "develop": "ng serve --port 3043",
    "build": "node scripts/build.mjs",
    "build:gh": "node scripts/build.mjs --base-href /ar-atrium/",
    "watch": "ng build --watch --configuration development",
    "copy-error-page": "node scripts/copy-error-page.mjs",
    "test": "ng test",
    "precommit:dummy": "echo 'This is a dummy print message!'",
    "precommit": "run-s format:fix lint",
    "format:fix": "pretty-quick --staged",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"tools/*.{mts,mjs}\" \"scripts/*.{js,mjs}\" \"public/data/**/*.json\" .github/workflows/*.yml README.md",
    "format:all": "prettier --write \"src/**/*.{ts,html,scss}\" \"tools/*.{mts,mjs}\" \"scripts/*.{js,mjs}\" \"public/data/**/*.json\" .github/workflows/*.yml README.md",
    "lint": "ng lint",
    "prepare": "husky",
    "catalog:build": "node tools/catalog.mts build",
    "catalog:validate": "node tools/catalog.mts validate",
    "catalog:sync": "node tools/catalog.mts sync",
    "test:catalog": "node --test tools/*.test.mts",
    "prestart": "node tools/catalog.mts build",
    "predevelop": "node tools/catalog.mts build",
    "prebuild": "node tools/catalog.mts build",
    "prebuild:gh": "node tools/catalog.mts build",
    "prewatch": "node tools/catalog.mts build",
    "test:ci": "ng test --watch=false",
    "typecheck:tools": "tsc -p tsconfig.tools.json"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "gsap": "^3.15.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "angular-eslint": "22.6.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "pretty-quick": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.60.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.22.3 || >=24.15.0 || >=26.0.0"
  }
}
