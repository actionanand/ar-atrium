{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projects": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "web",
                "github",
                "docs",
                "npm",
                "apk",
                "other"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "verified": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "kind",
            "label",
            "url"
          ]
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "projects"
  ]
}
