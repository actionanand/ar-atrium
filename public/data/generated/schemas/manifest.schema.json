{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "repositories": {
      "type": "string",
      "minLength": 1
    },
    "hosting": {
      "type": "string",
      "minLength": 1
    },
    "taxonomy": {
      "type": "string",
      "minLength": 1
    },
    "policyHub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "minLength": 1
        },
        "websiteUrl": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository",
        "sourceUrl",
        "websiteUrl",
        "snapshot"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "tagline",
    "description",
    "projects",
    "repositories",
    "hosting",
    "taxonomy",
    "policyHub"
  ]
}
