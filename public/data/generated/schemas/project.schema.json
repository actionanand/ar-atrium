{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "projectType": {
      "type": "string",
      "minLength": 1
    },
    "featured": {
      "type": "boolean"
    },
    "visible": {
      "type": "boolean"
    },
    "needsReview": {
      "type": "boolean"
    },
    "classificationReview": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "iconUrl": {
      "type": "string",
      "minLength": 1
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "facets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "relatedProjects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageUrl": {
          "type": "string",
          "minLength": 1
        },
        "imageAlt": {
          "type": "string",
          "minLength": 1
        },
        "demoUrl": {
          "type": "string",
          "minLength": 1
        },
        "demoPublic": {
          "type": "boolean"
        },
        "iframeUrl": {
          "type": "string",
          "minLength": 1
        },
        "allowIframe": {
          "type": "boolean"
        }
      },
      "required": []
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "ref",
          "role"
        ]
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "web",
              "github",
              "docs",
              "npm",
              "apk",
              "other"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "verified": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "url"
        ]
      }
    },
    "policyHub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "appId"
      ]
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "projectType": {
          "type": "string",
          "minLength": 1
        },
        "featured": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        },
        "needsReview": {
          "type": "boolean"
        },
        "classificationReview": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "iconUrl": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "addLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "web",
                  "github",
                  "docs",
                  "npm",
                  "apk",
                  "other"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "verified": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "kind",
              "label",
              "url"
            ]
          }
        },
        "removeLinks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "addRepositories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "order": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "ref",
              "role"
            ]
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "hidden": {
                "type": "boolean"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "policyHub": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "iconUrl": {
              "type": [
                "string",
                "null"
              ]
            },
            "platform": {
              "enum": [
                "web",
                "android"
              ]
            },
            "releasedToPlayStore": {
              "type": "boolean"
            },
            "playStoreUrl": {
              "type": [
                "string",
                "null"
              ]
            },
            "hideAndroidLinks": {
              "type": "boolean"
            }
          },
          "required": []
        }
      },
      "required": []
    },
    "collection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "series"
            },
            "parts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "repositoryRef": {
                    "type": "string",
                    "minLength": 1
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "number",
                  "title",
                  "repositoryRef"
                ]
              },
              "minItems": 2
            }
          },
          "required": [
            "mode",
            "parts"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "variants"
            },
            "variants": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "order": {
                    "type": "integer"
                  },
                  "rootRepositoryRef": {
                    "type": "string",
                    "minLength": 1
                  },
                  "repositoryRefs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "label",
                  "order",
                  "rootRepositoryRef",
                  "repositoryRefs"
                ]
              },
              "minItems": 2
            }
          },
          "required": [
            "mode",
            "variants"
          ]
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "category",
    "projectType",
    "visible",
    "featured",
    "repositories",
    "links",
    "overrides"
  ]
}
